# Copy to .env to change defaults (docker compose reads .env automatically). ./fr3 sets MODE, RVIZ and the domain.
# FR3_PROJECT=asu-fr3                  # compose project prefix; another value + another ROS_DOMAIN_ID runs a second, independent stack
# ASU_FR3_IMAGE=asu-fr3:0.1.0-dev      # or ghcr.io/mohamedmsamy/asu-fr3:<version>
# ROS_DOMAIN_ID=100                    # default 100 (mujoco, isaac) and 101 (real)
# RMW=cyclone                          # cyclone | fastdds
# ROS_NETWORK_INTERFACE=lo             # Cyclone interface
# FR3_SCENE=scene_fric_gravcomp_v1.xml # MuJoCo scene in models/ (default for mujoco)
# CONTROLLERS_FILE=controllers.yaml    # gains file in config/ (default for mujoco)
# RVIZ_CONFIG=asu_fr3.rviz             # RViz profile in config/ (used with ./fr3 up <mode> --rviz)
# ROBOT_IP=172.16.0.2                  # real mode
# --- isaac mode (topics the Isaac side publishes and subscribes to) ---
# ISAAC_JOINT_STATES_TOPIC=/isaac_joint_states        # sensor_msgs/JointState: Isaac -> controller (position, velocity)
# ISAAC_JOINT_COMMANDS_TOPIC=/isaac_joint_commands    # sensor_msgs/JointState: controller -> Isaac (effort)
# ISAAC_SUM_WRAPPED_JOINT_STATES=false                # true if Isaac reports joint angles wrapped to +/- 2 pi
# ISAAC_EFFORT_INITIAL_VALUE=0.0                      # effort command before a controller writes; "none" = NaN
# BRIDGE_PHYSICS_HZ=1000                              # physics rate of the MuJoCo stand-in (./fr3 up isaac --standin)
# ISAAC_COMMAND_THRESHOLD=                            # empty = plugin default; -1 = publish the effort command every cycle (if Isaac does not hold the last torque)
# BRIDGE_REALTIME_FACTOR=1.0                          # stand-in speed: 0.2 emulates an Isaac Sim running at 0.2x real time
# CYCLONE_CONFIG=cyclone_config.xml                   # Cyclone file in config/ (isaac mode uses cyclone_isaac.xml: unicast discovery over lo)

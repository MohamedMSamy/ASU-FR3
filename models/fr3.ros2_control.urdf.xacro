<?xml version='1.0' encoding='utf-8'?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

<!-- 
  ROS2 Control configuration for Franka robot
  Parameters:
    - arm_id: Identifier for the robot arm
    - robot_ip: IP address of the real robot (used when not in simulation)
    - use_fake_hardware: Set to true for simulation, false for real hardware
    - arm_prefix: Optional prefix for all joint names
-->
<!-- Absolute path of the MuJoCo scene; the launch passes the resolved file (FR3_SCENE). -->
<xacro:arg name="mujoco_model" default=""/>

<!-- Hardware backend. "isaac" selects the topic-based plugin (Isaac Sim over ROS topics); anything else keeps the
     old behaviour (use_fake_hardware false: franka_hardware, true: MuJoCo). The launch sets it from mode:=.
     isaac_effort_initial_value: command value before a controller writes (default 0.0; "none" leaves it unset = NaN). -->
<xacro:arg name="hardware" default=""/>
<xacro:arg name="isaac_joint_states_topic" default="/isaac_joint_states"/>
<xacro:arg name="isaac_joint_commands_topic" default="/isaac_joint_commands"/>
<xacro:arg name="isaac_sum_wrapped_joint_states" default="false"/>
<xacro:arg name="isaac_effort_initial_value" default="0.0"/>
<!-- isaac_command_threshold: plugin parameter trigger_joint_command_threshold. Empty (default) = the plugin default (1e-5: a command is only
     published when it differs from the reported effort). -1 = publish every cycle (use it if Isaac does not hold the last torque). -->
<xacro:arg name="isaac_command_threshold" default=""/>

<xacro:macro name="franka_arm_ros2_control"
         params="arm_id
             robot_ip
             use_fake_hardware
             arm_prefix:=''">
    <xacro:property name="arm_prefix_modified" value="${'' if arm_prefix == '' else arm_prefix + '_'}" />
    <xacro:property name="is_isaac" value="${xacro.arg('hardware') == 'isaac'}" />
    <xacro:property name="effort_init" value="${xacro.arg('isaac_effort_initial_value')}" />
    <xacro:property name="cmd_threshold" value="${xacro.arg('isaac_command_threshold')}" />

    <ros2_control name="${arm_prefix_modified}FrankaHardwareInterface" type="system">
        <hardware>
          <param name="arm_id">${arm_id}</param>
          <param name="prefix">${arm_prefix}</param>

          <xacro:unless value="${use_fake_hardware}">
            <plugin>franka_hardware/FrankaHardwareInterface</plugin>
            <param name="version">0.1.0</param>
            <param name="robot_ip">${robot_ip}</param>
            <param name="arm_prefix">${arm_prefix}</param>
          </xacro:unless>
          <xacro:if value="${use_fake_hardware}">
            <xacro:unless value="${is_isaac}">
              <plugin>crisp_mujoco_sim/Simulator</plugin>
              <param name="mujoco_model">$(arg mujoco_model)</param>
            </xacro:unless>
            <xacro:if value="${is_isaac}">
              <plugin>joint_state_topic_hardware_interface/JointStateTopicSystem</plugin>
              <param name="joint_commands_topic">$(arg isaac_joint_commands_topic)</param>
              <param name="joint_states_topic">$(arg isaac_joint_states_topic)</param>
              <param name="sum_wrapped_joint_states">$(arg isaac_sum_wrapped_joint_states)</param>
              <xacro:unless value="${cmd_threshold == ''}">
                <param name="trigger_joint_command_threshold">${cmd_threshold}</param>
              </xacro:unless>
            </xacro:if>
          </xacro:if>
        </hardware>

      <xacro:macro name="configure_joint" params="joint_name initial_position">
        <joint name="${joint_name}">
          <xacro:unless value="${use_fake_hardware}">
            <command_interface name="position"/>
            <command_interface name="velocity"/>
          </xacro:unless>

          <xacro:unless value="${is_isaac}">
            <command_interface name="effort"/>
          </xacro:unless>
          <xacro:if value="${is_isaac}">
            <command_interface name="effort">
              <xacro:unless value="${effort_init == 'none'}">
                <param name="initial_value">${effort_init}</param>
              </xacro:unless>
            </command_interface>
          </xacro:if>

          <state_interface name="position">
            <param name="initial_value">${initial_position}</param>
          </state_interface>
          <state_interface name="velocity"/>
          <state_interface name="effort"/>
        </joint>
      </xacro:macro>

      <xacro:configure_joint joint_name="${arm_prefix}${arm_id}_joint1" initial_position="0.0"/>
      <xacro:configure_joint joint_name="${arm_prefix}${arm_id}_joint2" initial_position="${-pi/4}"/>
      <xacro:configure_joint joint_name="${arm_prefix}${arm_id}_joint3" initial_position="0.0"/>
      <xacro:configure_joint joint_name="${arm_prefix}${arm_id}_joint4" initial_position="${-3*pi/4}"/>
      <xacro:configure_joint joint_name="${arm_prefix}${arm_id}_joint5" initial_position="0.0"/>
      <xacro:configure_joint joint_name="${arm_prefix}${arm_id}_joint6" initial_position="${pi/2}"/>
      <xacro:configure_joint joint_name="${arm_prefix}${arm_id}_joint7" initial_position="${pi/4}"/>

    </ros2_control>
  </xacro:macro>
</robot>
